# EscalasPT — Caddy reverse proxy
# Place this file at /etc/caddy/Caddyfile on the VPS
# Replace YOURDOMAIN with your DuckDNS subdomain (e.g., escalaspt.duckdns.org)

YOURDOMAIN.duckdns.org {
	reverse_proxy localhost:8443 {
		# Overwrite, never append. Caddy's default is to keep whatever
		# X-Forwarded-For the client sent and add the peer to it, which lets
		# anyone put an address of their choosing at the front of the chain —
		# and nginx and the API both read that header to decide who is being
		# rate limited.
		#
		# {client_ip}, not {remote_host}: behind a CDN the immediate peer is
		# the CDN, and using it would put every visitor in one bucket again.
		# {client_ip} is whatever the global trusted_proxies setting resolves
		# the real client to, and falls back to the peer when there is no CDN
		# in front. If you put Cloudflare (or anything similar) ahead of this,
		# set trusted_proxies to its ranges in the global block or the value
		# here is the CDN's address.
		header_up X-Forwarded-For {client_ip}
	}

	# Compress responses
	encode gzip zstd

	# Security headers (supplement nginx)
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	# Logging
	log {
		output file /var/log/caddy/escalaspt.log {
			roll_size 10mb
			roll_keep 3
		}
	}
}
