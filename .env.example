# ============================================================
# Caderno de Serviço — environment
# deploy/setup.sh generates every GENERATE_ME value. Nothing here should ever
# be committed with a real value.
# ============================================================

APP_NAME="Caderno de Serviço"
APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=INFO

# ── Database ────────────────────────────────────────────────
# POSTGRES_USER owns the tables and is used ONLY by Alembic.
POSTGRES_USER=caderno_owner
POSTGRES_PASSWORD=GENERATE_ME
POSTGRES_DB=caderno

# The API connects as this limited role (created by backend/scripts/init_db.sql).
CADERNO_APP_DB_PASSWORD=GENERATE_ME

# Overridden by docker-compose; set for local development without Docker.
DATABASE_URL=postgresql+asyncpg://caderno_app:GENERATE_ME@localhost:5433/caderno
TEST_DATABASE_URL=postgresql+asyncpg://caderno_app:GENERATE_ME@localhost:5433/caderno_test

# ── Redis ───────────────────────────────────────────────────
REDIS_PASSWORD=GENERATE_ME
REDIS_URL=redis://:GENERATE_ME@localhost:6380/0

# ── JWT ─────────────────────────────────────────────────────
JWT_SECRET_KEY=GENERATE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Encryption keys (Fernet, one purpose each) ──────────────
# Generated now even though phases 1+ use them: rotating a key later is work,
# generating one now is free.
TOTP_ENCRYPTION_KEY=GENERATE_ME
FIELD_ENCRYPTION_KEY=GENERATE_ME
ATTACHMENT_MASTER_KEY=GENERATE_ME
IDENT_FIELD_KEY=GENERATE_ME
IDENT_INDEX_KEY=GENERATE_ME

# ── CORS (same-origin in production; only matters for npm run dev) ──
CORS_ORIGINS=["http://localhost:5173"]

# ── Rate limiting ───────────────────────────────────────────
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_DEFAULT=120/minute
